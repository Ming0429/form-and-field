    "demo:record": "node scripts/record-demo.mjs",
    "format": "prettier --write src tests scripts *.json *.ts index.html"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
